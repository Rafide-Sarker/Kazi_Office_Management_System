<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #2C7A7B, #16353D);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kazi_office_and_marriage_register_office.loginPageController">
   <children>
      <Pane layoutX="199.0" layoutY="128.0" prefHeight="434.0" prefWidth="500.0" style="-fx-background-color: #0E2227; -fx-background-radius: 8;">
         <children>
            <TextField layoutX="100.0" layoutY="38.0" prefHeight="40.0" prefWidth="300.0" promptText="Username" />
            <PasswordField layoutX="100.0" layoutY="108.0" prefHeight="40.0" prefWidth="300.0" promptText="password" />
            <ComboBox fx:id="selectRoleUserLoginComboBox" layoutX="100.0" layoutY="176.0" prefHeight="40.0" prefWidth="300.0" promptText="Select Role" style="-fx-border-color: #D9D9D9; -fx-border-radius: 5;" />
            <Hyperlink layoutX="195.0" layoutY="236.0" onAction="#forgetPasswordButtonOnAction" text="Forgot Password" />
            <Button layoutX="165.0" layoutY="276.0" mnemonicParsing="false" onAction="#loginButtonOnAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #1E3F46; -fx-text-fill: #F5F5F5; -fx-background-radius: 8;" text="LOGIN">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Button>
            <Label fx:id="Hudai" layoutX="183.0" layoutY="341.0" style="-fx-text-fill: #CFCFCF;" text="Don't have an account?">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Button layoutX="145.0" layoutY="374.0" mnemonicParsing="false" onAction="#createNewAccountOnAction" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: #1E3F46; -fx-text-fill: #F5F5F5; -fx-background-radius: 8;" text="Create New Account">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Button>
            <Label layoutX="100.0" layoutY="14.0" text="Username" textFill="WHITESMOKE" />
            <Label layoutX="100.0" layoutY="85.0" text="Password" textFill="WHITESMOKE" />
         </children>
      </Pane>
      <Label layoutX="247.0" layoutY="31.0" style="-fx-text-fill: #F5F5F5;" text="KAZI OFFICE MANAGEMENT SYSTEM">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="400.0" layoutY="85.0" style="-fx-text-fill: #F5F5F5;" text="User Login">
         <font>
            <Font name="Segoe UI Bold" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
