<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #2C7A7B, #16353D);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kazi_office_and_marriage_register_office.ForgetPasswordController">
   <children>
      <Label layoutX="240.0" layoutY="39.0" style="-fx-text-fill: #F5F5F5;" text="KAZI OFFICE MANAGEMENT SYSTEM">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="378.0" layoutY="87.0" style="-fx-text-fill: #F5F5F5;" text="Forgot Password">
         <font>
            <Font name="Segoe UI Bold" size="18.0" />
         </font>
      </Label>
      <Pane layoutX="199.0" layoutY="128.0" prefHeight="434.0" prefWidth="500.0" style="-fx-background-color: #0E2227; -fx-background-radius: 8;">
         <children>
            <TextField layoutX="100.0" layoutY="38.0" prefHeight="40.0" prefWidth="300.0" promptText="Enter NID Number" />
            <TextField layoutX="100.0" layoutY="108.0" prefHeight="40.0" prefWidth="300.0" promptText="Enter Email" />
            <TextField layoutX="100.0" layoutY="177.0" prefHeight="40.0" prefWidth="300.0" promptText="Enter Phone Number" />
            <Button layoutX="140.0" layoutY="253.0" mnemonicParsing="false" onAction="#sendVerificationCodeOnAction" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: #1E3F46; -fx-text-fill: #F5F5F5; -fx-background-radius: 8;" text="Send Verification Code">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Button>
            <Hyperlink layoutX="180.0" layoutY="341.0" onAction="#backToLoginPageOnAction" text="&lt;-- Back to Login Page" />
         </children>
      </Pane>
   </children>
</AnchorPane>
