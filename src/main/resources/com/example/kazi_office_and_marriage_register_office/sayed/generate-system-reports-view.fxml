<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="453.0" prefWidth="553.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kazi_office_and_marriage_register_office.sayed.GenerateSystemReportController">
   <children>
      <Label layoutX="206.0" layoutY="14.0" text="Generate System Reports" textFill="RED">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <Label layoutX="59.0" layoutY="57.0" text="Report Type" />
      <ComboBox fx:id="reportTypeComboBox" layoutX="59.0" layoutY="74.0" prefWidth="150.0" />
      <Label layoutX="59.0" layoutY="121.0" text="From Date" />
      <DatePicker fx:id="fromDatePicker" layoutX="59.0" layoutY="138.0" />
      <DatePicker fx:id="toDatePicker" layoutX="357.0" layoutY="138.0" />
      <Label layoutX="359.0" layoutY="119.0" text="To Date" />
      <Button layoutX="237.0" layoutY="183.0" mnemonicParsing="false" onAction="#generateReportButtonOnAction" text="Generate Report" />
      <Label layoutX="59.0" layoutY="209.0" text="Report Preview" />
      <TextArea fx:id="reportPreviewTextArea" editable="false" layoutX="59.0" layoutY="235.0" prefHeight="69.0" prefWidth="459.0" promptText="Generate report will appear here" wrapText="true" />
      <Label layoutX="60.0" layoutY="318.0" text="Report Status:" />
      <Label fx:id="reportStatusLabel" layoutX="146.0" layoutY="318.0" prefHeight="17.0" prefWidth="215.0" text="Not Generated" />
      <Button layoutX="166.0" layoutY="378.0" mnemonicParsing="false" onAction="#exportReportButtonOnAction" text="Export Report " />
      <Button layoutX="336.0" layoutY="378.0" mnemonicParsing="false" onAction="#backAndGoToDashboardButtonOnAction" text="Back " />
   </children>
</AnchorPane>
